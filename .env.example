# Copy this to .env and fill in values
# For local dev with direct Anthropic API:
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
USE_BEDROCK=false

# For regulated enterprise production with Bedrock:
# USE_BEDROCK=true
# AWS_REGION=us-east-1
# (Bedrock uses IAM role / instance profile — no API key needed)
